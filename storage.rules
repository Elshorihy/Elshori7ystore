rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /apps/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin()) && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin()) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
